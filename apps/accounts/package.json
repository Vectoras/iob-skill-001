{
  "name": "accounts",
  "private": true,
  "scripts": {
    "dev:lean": "PORT=8080 wgo -xdir tmp go build -o ./tmp/accounts ./cmd/accounts :: ./tmp/accounts",
    "dev:full": "PORT=8080 wgo -xdir tmp go build -gcflags='all=-N -l' -o ./tmp/accounts ./cmd/accounts :: dlv exec ./tmp/accounts --headless --listen=127.0.0.1:2345 --api-version=2 --accept-multiclient --continue",
    "build": "go build -o ./dist/accounts ./cmd/accounts",
    "openapi": "go run ./cmd/openapi",
    "lint:fix": "golangci-lint run --fix ./...",
    "lint:check": "golangci-lint run ./...",
    "format:fix": "golangci-lint fmt ./... && prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "golangci-lint fmt --diff ./... && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test:unit": "go test ./..."
  }
}
