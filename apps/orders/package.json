{
  "name": "orders",
  "private": true,
  "scripts": {
    "dev:lean": "PORT=8081 wgo -xdir tmp go build -o ./tmp/orders ./cmd/orders :: ./tmp/orders",
    "dev:full": "PORT=8081 wgo -xdir tmp go build -gcflags='all=-N -l' -o ./tmp/orders ./cmd/orders :: dlv exec ./tmp/orders --headless --listen=127.0.0.1:2346 --api-version=2 --accept-multiclient --continue",
    "build": "go build -o ./dist/orders ./cmd/orders",
    "openapi": "go run ./cmd/openapi",
    "lint:fix": "golangci-lint run --fix ./...",
    "lint:check": "golangci-lint run ./...",
    "format:fix": "golangci-lint fmt ./... && prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "golangci-lint fmt --diff ./... && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test:unit": "go test ./..."
  },
  "devDependencies": {
    "go-types": "workspace:*"
  }
}
