{
  "name": "go-types",
  "private": true,
  "scripts": {
    "lint:fix": "golangci-lint run --fix ./...",
    "lint:check": "golangci-lint run ./...",
    "format:fix": "golangci-lint fmt ./... && prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "golangci-lint fmt --diff ./... && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test:unit": "go test ./..."
  }
}
