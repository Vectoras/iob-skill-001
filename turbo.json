{
  "$schema": "./node_modules/turbo/schema.json",
  "globalPassThroughEnv": [
    "GOPATH",
    "GOCACHE",
    "GOLANGCI_LINT_CACHE",
    "GOTOOLCHAIN"
  ],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/go.mod"],
      "outputs": ["generated/**"]
    },
    "dev:lean": {
      "dependsOn": ["^generate", "generate"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["ACCOUNTS_SECRET", "ORDERS_SECRET"]
    },
    "dev:full": {
      "dependsOn": ["^generate", "generate"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["ACCOUNTS_SECRET", "ORDERS_SECRET"]
    },
    "storybook:dev": {
      "dependsOn": ["^generate", "generate"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": []
    },
    "storybook:build": {
      "dependsOn": ["^generate", "generate"],
      "outputs": ["storybook-static/**"]
    },
    "build": {
      "dependsOn": ["^generate", "generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:unit": {
      "dependsOn": ["^generate", "generate"],
      "inputs": ["$TURBO_DEFAULT$"],
      "passThroughEnv": []
    },
    "openapi": {
      "outputs": ["generated/**"]
    },
    "lint:fix": {
      "cache": false
    },
    "lint:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.golangci.yml"
      ]
    },
    "format:fix": {
      "cache": false
    },
    "format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.prettierrc",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/.editorconfig",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.golangci.yml"
      ]
    }
  }
}
