{
  "$schema": "./node_modules/turbo/schema.json",
  "globalPassThroughEnv": [
    "GOPATH",
    "GOCACHE",
    "GOLANGCI_LINT_CACHE",
    "GOTOOLCHAIN",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tools/go.mod"],
      "outputs": ["generated/**"]
    },
    "dev:lean": {
      "dependsOn": ["^generate", "generate"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["API_URL", "API_SECRET"]
    },
    "dev:full": {
      "dependsOn": ["^generate", "generate"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["API_URL", "API_SECRET"]
    },
    "storybook:dev": {
      "dependsOn": ["^generate", "generate"],
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["API_URL", "API_SECRET"]
    },
    "storybook:build": {
      "dependsOn": ["^generate", "generate"],
      "outputs": ["storybook-static/**"]
    },
    "build": {
      "dependsOn": ["^generate", "generate"],
      "outputs": ["dist/**"]
    },
    "web#build": {
      "dependsOn": ["^generate", "generate"],
      "outputs": [".svelte-kit/output/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test:unit": {
      "dependsOn": ["^generate", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "passThroughEnv": ["API_URL", "API_SECRET"]
    },
    "test:e2e": {
      "dependsOn": ["^generate", "generate"],
      "env": ["WEB_URL"]
    },
    "openapi": {
      "outputs": ["generated/**"]
    },
    "lint:fix": {
      "cache": false
    },
    "lint:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.golangci.yml",
        "$TURBO_ROOT$/eslint.config.js"
      ]
    },
    "format:fix": {
      "cache": false
    },
    "format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.prettierrc",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/.editorconfig",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.golangci.yml"
      ]
    }
  }
}
